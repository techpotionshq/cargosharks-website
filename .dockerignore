# The build stage installs from the lockfile and builds from source. Anything
# produced on a developer's machine is either useless in the image or actively
# wrong in it — a macOS `node_modules` shadowing a Linux install is the classic
# way to ship a broken `sharp`.

node_modules
**/node_modules
.pnpm-store

# Build output — regenerated in the image, and stale copies would be preferred
# over the fresh ones by `COPY . .`.
.next
**/.next
dist
**/dist
out
build
*.tsbuildinfo

# Secrets. `next.config.ts` calls `loadEnv()` at build time, so a `.env.local`
# in the context would put a developer's connection strings into the image.
.env
.env.*
!.env.example

# History, tooling output and editor state: large, and nothing reads them.
.git
.github
coverage
playwright-report
test-results
.vitest
docs
*.log
tmp
.DS_Store
.idea
.vscode
