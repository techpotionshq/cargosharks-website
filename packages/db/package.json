{
  "name": "@qabandi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The only place a field is defined. Drizzle schema, RLS policies, audit triggers.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./actor": "./src/actor.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "generate:custom": "drizzle-kit generate --custom",
    "migrate": "tsx src/migrate.ts",
    "build:migrate": "node build-migrate.mjs",
    "push": "node -e \"console.error(\\\"drizzle-kit push is forbidden: migrations are forward-only and applied by app_migrator (Architecture 5.1, 13). push force-syncs the TS schema onto a live database and knows nothing about the hand-written policies, triggers and grants that enforce tenancy. Use pnpm db:generate (DDL) or pnpm db:generate:custom (hand-written), then pnpm db:migrate.\\\"); process.exit(1)\"",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "seed-demo": "tsx src/seed-demo.ts",
    "diagnose": "tsx src/diagnose.ts",
    "test": "vitest run",
    "provision": "tsx src/provision.ts",
    "create-user": "tsx src/create-user.ts",
    "tenant-new": "tsx src/tenant-new.ts",
    "fleet-migrate": "tsx src/fleet-migrate.ts",
    "fleet-backup": "tsx src/fleet-backup.ts",
    "create-branch": "tsx src/create-branch.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@qabandi/brand": "workspace:*",
    "@qabandi/core": "workspace:*",
    "better-auth": "^1.6.29",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
