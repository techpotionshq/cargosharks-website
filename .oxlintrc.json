{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/migrations/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "off",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": [
        "packages/core/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@qabandi/*",
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "next",
                  "next/*",
                  "fastify",
                  "pg",
                  "pg-boss",
                  "node:*"
                ],
                "message": "packages/core is pure domain: no I/O, no DB, no framework (Architecture \u00a74). Take the value as a parameter instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/db/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@qabandi/web",
                  "@qabandi/service",
                  "next",
                  "next/*",
                  "fastify"
                ],
                "message": "Dependency direction is core <- db <- {web, service} (Architecture \u00a74)."
              }
            ]
          }
        ]
      }
    }
  ]
}
