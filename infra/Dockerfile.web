# The web container — Release One runs this on the client's cloud (NFR-17).
#
# The pilot deploys the same application to Vercel instead (§3.1). Nothing in
# the image is Vercel-specific and nothing is Supabase-specific, which is what
# makes that move a connection string and a DNS change.

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

FROM base AS build
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @qabandi/web...
COPY . .
RUN pnpm --filter @qabandi/web build

FROM base AS runtime
WORKDIR /app
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public

USER node
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
