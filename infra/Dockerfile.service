# The service container — workers, PDF rendering, webhooks, public read API.
#
# Chromium is installed here rather than pulled through npm: it is the only
# renderer with dependable Arabic shaping and RTL (NFR-01), and it belongs in
# the image rather than in a developer's node_modules.

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

FROM base AS build
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY apps/service/package.json apps/service/
RUN pnpm install --frozen-lockfile --filter @qabandi/service...
COPY . .
RUN pnpm --filter @qabandi/service build

FROM base AS runtime
WORKDIR /app

# Chromium and the fonts Arabic rendering needs. Without the Arabic font the
# PDF renders boxes, which is the sort of failure that only shows up in
# production on a customer's invoice.
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation fonts-noto-core fonts-noto-color-emoji \
      fonts-kacst fonts-freefont-ttf ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/service/package.json apps/service/
# `@qabandi/service...` — the package *and its dependencies*.
#
# Without the ellipsis pnpm installs only what `apps/service/package.json`
# names, and the bundle needs more: `build.mjs` inlines the workspace source
# but leaves npm packages external, so `pg` and `drizzle-zod` (from
# `@qabandi/db`) and `decimal.js` (from `@qabandi/core`) are imported at
# runtime by code that no longer sits in a package declaring them. The
# container started, then died on `Cannot find package 'pg'`.
RUN pnpm install --frozen-lockfile --prod --filter @qabandi/service...

COPY --from=build /app/apps/service/dist apps/service/dist

USER node
ENV NODE_ENV=production
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://localhost:3001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/service/dist/index.js"]
