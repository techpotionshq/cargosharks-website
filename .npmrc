strict-peer-dependencies=false
auto-install-peers=true

# The release-age floor lives in `pnpm-workspace.yaml` as `minimumReleaseAge`,
# and deliberately nowhere else. It was written here too, as `min-release-age=7`,
# and that line was a no-op twice over: neither npm nor pnpm knows that name —
# npm answered `Unknown project config "min-release-age"` on every invocation in
# this repository — and pnpm's kebab spelling is `minimum-release-age`, whose
# unit is *minutes*, so even corrected the 7 would have bought seven minutes
# rather than seven days.
#
# It is left commented rather than fixed in place, because the correct spelling
# is read by pnpm from this file and would enforce the floor immediately —
# breaking `pnpm install --frozen-lockfile` on the four packages published
# 20–21 August 2026 that `pnpm-workspace.yaml` postpones for. That is the exact
# outcome that file's header set out to avoid. Uncomment both together, from
# **28 August 2026**, and verify with `pnpm install --frozen-lockfile`.
#
# minimum-release-age=10080
