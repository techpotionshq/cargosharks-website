# ---------------------------------------------------------------------------
# Qabandi — local development environment.
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (§5.1) -------------------------------------------------------
# Superuser, used by `pnpm db:provision` to create the database and the two
# application roles on a server where the container entrypoint is not available.
# Never used by the running application; leave unset once provisioned.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# The application connects as app_user: no BYPASSRLS, no table ownership.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/qabandi
# Migrations only. Owns every object. Never used by web or service at runtime.
MIGRATION_DATABASE_URL=postgres://app_migrator:app_migrator@localhost:5432/qabandi

# Set true behind PgBouncer in transaction-pooling mode.
DATABASE_POOLED=false
DATABASE_POOL_MAX=10

# The RLS policy tests need both roles and skip entirely without them (§13).
TEST_DATABASE_URL=postgres://app_user:app_user@localhost:5432/qabandi
TEST_MIGRATION_DATABASE_URL=postgres://app_migrator:app_migrator@localhost:5432/qabandi

# --- Auth (§8) -------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-bytes-of-base64
BETTER_AUTH_URL=http://localhost:3000

# --- Brand / whitelabel (NFR-16, FR-CP-01) ---------------------------------
# Every colour, name and mark in the product resolves from @qabandi/brand.
# Nothing below is required: unset, the product is Al-Qabandi. Set any of them
# and the whole interface — screens, PDFs, favicon — re-skins with no rebuild,
# because the tokens are emitted as CSS custom properties at request time.
#
# Onboarding a second operator properly is one file under
# packages/brand/src/brands/, registered in resolve.ts, then BRAND=<key>.
# These overrides are for a re-skin between two meetings, and for making
# preview deployments visibly not production.
BRAND=qabandi

# Identity.
# BRAND_NAME_EN="Al-Qabandi & Partners"
# BRAND_NAME_AR="القبندي وشركاه"
# BRAND_TAGLINE_EN="Shipping & Forwarding"
# BRAND_SHORT_NAME=AQP
# BRAND_MONOGRAM=Q

# Palette. Hue is an OKLCH angle 0–360; chroma ~0.10–0.20 for a brand colour.
# Both themes, all three ramps and the chart series are derived from these.
#
# Al-Qabandi's own values, taken from their live site, are the defaults:
#   primary  red  #da2726  -> hue 27.4, chroma 0.19
#   accent   navy #1d2143  -> hue 276,  chroma 0.105
# BRAND_PRIMARY_HUE=27.4
# BRAND_PRIMARY_CHROMA=0.19
# BRAND_ACCENT_HUE=276
# BRAND_ACCENT_CHROMA=0.105
# BRAND_RADIUS=10
#
# The five status colours are reserved and do NOT move with the brand —
# positive is green (158), critical is red (27). A brand hue within ~15 degrees
# of one of those reads as that status.
#
# Al-Qabandi's red sits *on* `critical`, which is why these two exist:
#
#   - the chrome is cut from the accent ramp, so the sidebar is navy rather
#     than four hundred pixels of alarm colour;
#   - the neutral tint follows the accent hue, because tinting every grey with
#     a red brand hue turns the whole interface pink.
#
# Change these together with the primary hue, or not at all.
# BRAND_CHROME_RAMP=accent      # primary | accent | neutral
# BRAND_NEUTRAL_HUE=276
#
# The chart series never uses the brand hue and never a status hue; see
# DEFAULT_CHART_SLOTS in packages/brand/src/palette.ts. Changing a slot means
# re-running the data-viz palette validator against both themes.

# Supply the client's own artwork as an inline square-viewBox SVG; it replaces
# the generated monogram everywhere, including the favicon and PDF letterhead.
# BRAND_LOGO_SVG="<svg viewBox='0 0 48 48'>…</svg>"

# Contact — printed on documents and shown on the customer-facing surfaces.
# BRAND_TRACKING_URL=https://track.qabandi.com
# BRAND_SUPPORT_EMAIL=operations@qabandi.com
# BRAND_SUPPORT_PHONE="+965 2483 0000"

# --- Pilot data (Pilot §3.1 item 14) ---------------------------------------
# The interface runs on the seeded pilot dataset — 20 jobs, a live customs
# hold, a demurrage clock — instead of the database. Defaults to on whenever
# DATABASE_URL is unset, which is what lets the whole thing run on a laptop
# with nothing provisioned, and survive a demo room with no network.
# It refuses to engage in production against a configured database.
#
# Note that `apps/web` reads this file from the *workspace root* — Next only
# looks beside the app, so `next.config.ts` calls the same `loadEnv` the
# scripts use. Without it the app silently ran on fixtures despite a perfectly
# good DATABASE_URL two directories up.
QABANDI_PILOT_FIXTURES=0

# --- Apps ------------------------------------------------------------------
NODE_ENV=development
WEB_URL=http://localhost:3000
SERVICE_URL=http://localhost:3001
SERVICE_PORT=3001

# Shared secret for web -> service calls that are not user-authenticated.
#
# `SERVICE_URL` above must be an *internal* address in production — a container
# name on the private network, plain HTTP, port 3001. Never the service's
# public domain.
#
# The reason is what `/internal` does: this secret authenticates the caller,
# and the caller then names the principal to act as. Anyone holding it can read
# any branch's data. The service still needs a public domain — `/webhooks`
# takes carrier callbacks and `/api/v1` is the public tracking API — so the
# prefix is refused when a request arrives with proxy forwarding headers.
#
# Deployed from compose.deploy.yml, both containers share one network and this
# is literally the value:                    SERVICE_URL=http://service:3001
# Kept as two separate Coolify applications: enable "Connect to Predefined
#   Network" on both and use the renamed container name, http://service-<uuid>:3001
INTERNAL_API_SECRET=replace-me

# Accept `/internal` calls that arrive with forwarding headers.
#
# Off by default so a misconfigured proxy fails closed. Turn it on only where
# something on the *private* network legitimately adds those headers — a
# service mesh or a sidecar — and never to work around a public route reaching
# the prefix.
INTERNAL_API_TRUST_PROXY=false

# --- Files: FileStore port (§10) -------------------------------------------
#
# Defaults below point at the MinIO container in docker-compose.yml, so a
# fresh clone has working storage without an account anywhere.
#
# `memory` is the other driver: files live in the process and vanish with it.
# Useful for a test run, wrong for anything a person will look for twice.
#
# Cloudflare R2, which is what production uses:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto            # R2 ignores the value but signs with it
#   S3_FORCE_PATH_STYLE=true
# AWS proper wants the real region and `S3_FORCE_PATH_STYLE=false`, path-style
# addressing having been deprecated there.
#
# The credentials are the *service's* alone. `apps/web` never signs anything —
# it asks the service for a link (`/internal/files/signed-url`), which is why
# these belong in the service environment and SERVICE_URL above is what the web
# app needs instead.
FILE_STORE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qabandi-dev
S3_ACCESS_KEY_ID=qabandi
S3_SECRET_ACCESS_KEY=qabandi-dev-secret
S3_FORCE_PATH_STYLE=true

# --- Notifications (§7.4, FR-NT) -------------------------------------------
# `smtp` sends; `log` writes each message to the service log instead. Use `log`
# for a demonstration on a laptop, or for the first hour of a deployment whose
# relay credentials have not arrived — the boot line reads `email: log (not
# sending)` so it is never a silent failure.
MAIL_DRIVER=smtp

# Defaults are a local MailHog/Mailpit, which is what `docker compose` runs.
SMTP_HOST=localhost
SMTP_PORT=1025
# Implicit TLS from the first byte — port 465. Otherwise STARTTLS is used when
# the server advertises it.
SMTP_SECURE=false
# Credentials are never sent over an unencrypted connection: the adapter
# refuses at the first send rather than putting a mailbox password on the wire
# in reversible encoding. Use port 465 with SMTP_SECURE=true, or a port where
# the server advertises STARTTLS.
SMTP_USER=
SMTP_PASSWORD=
# Certificate verification. Set false only for a relay behind a private CA, and
# understand that it disables the check that the server is who it claims to be.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# A display name is understood: it goes in the `From:` header, and only the
# bare address goes in the SMTP envelope.
MAIL_FROM="Al-Qabandi & Partners <no-reply@qabandi.local>"

# WhatsApp Business API — provisioning is the client's (Discovery Q5).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Inbound email -> enquiry webhook (FR-EQ-02).
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- FX (FxRateSource port) ------------------------------------------------
# `manual` keeps Release One behaviour: rates are typed on the charge line.
# `api` turns on the daily refresh worker (`0 5 * * *`), which writes a dated
# row into fx_rates. Nothing reads the feed at quote time — a charge line
# stores the rate it was struck at and when (FR-RT-06).
#
# FX_API_URL is a template. `{base}` and `{key}` are substituted per request:
#   https://open.er-api.com/v6/latest/{base}      (free, no key, covers KWD)
FX_SOURCE=manual
FX_API_URL=
FX_API_KEY=
FX_BASE_CURRENCY=KWD
FX_QUOTE_CURRENCIES=USD,AED,EUR,GBP,SAR,QAR,BHD,OMR,INR,CNY

# --- Container tracking (CarrierTracking port, §10) -------------------------
# `manual` is Release One: operations types every milestone.
#
# `dcsa` is the driver to reach for. The carriers publish their own events to
# the DCSA Track & Trace standard, free — registration with Maersk,
# Hapag-Lloyd and CMA CGM is self-serve with a sandbox, and DCSA members are
# about three-quarters of container trade. The keys below are this
# deployment's own, which is what those licences contemplate.
#
# `terminal49` is the aggregator, and costs per container, recurring, scaling
# with the customer's volume rather than ours. It covers the carriers that
# publish nothing; it is a pricing decision before an engineering one.
CARRIER_TRACKING_DRIVER=manual
CARRIER_TRACKING_API_KEY=
CARRIER_TRACKING_BASE_URL=https://api.terminal49.com

# Carrier-direct credentials — one per carrier group, all free, all self-serve.
# Test a key the moment you paste it, against a real booking, with no database:
#   pnpm --filter @qabandi/service verify:tracking MAEU <booking-number>
# A carrier with no key here is simply one the hourly poll never asks about.
# Set the SCAC on the carrier's partner record (Admin › Partners) or the poll
# has no way to know which of these answers for a shipment.
#
# Maersk covers MAEU/MAEI/MCPU/SEAU/SEJJ — developer.maersk.com
# The Consumer-Key identifies the app. `track-and-trace-private` also wants an
# OAuth bearer, so set the client secret too where your tier issued one — the
# adapter exchanges it for a token and caches it. Blank means key-only auth.
DCSA_MAERSK_CONSUMER_KEY=
DCSA_MAERSK_CLIENT_SECRET=
# Hapag-Lloyd covers HLCU/HLXU and takes an id *and* a secret — api.hlag.com
DCSA_HAPAG_CLIENT_ID=
DCSA_HAPAG_CLIENT_SECRET=
# CMA CGM covers CMDU/ANNU/APLU/CHNL — apis.cma-cgm.net
DCSA_CMACGM_API_KEY=
#
# Each carrier's base URL, overridable because none of them has been run
# against a live key from this repository. Point these at the sandbox host
# from the carrier's own portal while you are testing; leave blank for the
# documented production gateway.
DCSA_MAERSK_BASE_URL=
DCSA_HAPAG_BASE_URL=
DCSA_CMACGM_BASE_URL=
# How many shipments one hourly run asks about. Carrier gateways rate-limit
# per key; soonest-ETA first, and the run reports what it left behind.
CARRIER_POLL_BATCH=150
# Required before /webhooks/terminal49 accepts anything. The endpoint writes to
# shipment history — an unauthenticated caller could move a discharge date, and
# a demurrage figure moves with it — so it refuses rather than trusting.
CARRIER_WEBHOOK_SECRET=

# --- E-invoice transmission (EInvoiceTransmit port, §10) --------------------
# `none` produces compliant invoice data and sends nothing, which is Release
# One. `asp` hands the finished document to an Accredited Service Provider.
#
# We cannot be the access point: Peppol accreditation requires two years of
# operating history. UAE PINT AE goes live 1 Jan 2027; ZATCA is already live.
EINVOICE_DRIVER=none
EINVOICE_ASP_URL=
EINVOICE_ASP_API_KEY=

# --- PDF (§8, NFR-01) ------------------------------------------------------
# Leave blank to use the Chromium that Playwright installs.
CHROMIUM_EXECUTABLE_PATH=

# --- Queue (pg-boss, §9) ---------------------------------------------------
PGBOSS_SCHEMA=pgboss
