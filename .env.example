# Copy to .env for `pnpm dev`. Production sets these in Coolify.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/cargosharks_cms
PAYLOAD_SECRET=change-me-to-a-long-random-string
SITE_URL=http://localhost:3002

# Where uploads are written. A volume in production.
MEDIA_DIR=media

# The daily drafting run (`node scripts/cron.mjs` -> POST /cron/blog/).
CRON_SECRET=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Cover photos for drafted posts (free key at pexels.com/api). Without it, no cover.
PEXELS_API_KEY=
# SEARXNG_URL=

# Optional: Slack messages on drafts and publishes, IndexNow on publish.
SLACK_BOT_TOKEN=
# SLACK_BLOG_CHANNEL=#blog-automation
# INDEXNOW=off
