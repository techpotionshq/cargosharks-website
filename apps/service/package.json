{
  "name": "@qabandi/service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify:storage": "tsx src/adapters/verify-file-store.ts",
    "verify:notifications": "tsx src/workers/verify-notifications.ts",
    "verify:last-mile": "tsx src/verify-last-mile.ts",
    "verify:tracking": "tsx src/adapters/verify-carrier-tracking.ts",
    "verify:model": "tsx src/adapters/verify-model.ts",
    "ai:eval": "tsx src/ai/eval.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@qabandi/brand": "workspace:*",
    "@qabandi/core": "workspace:*",
    "@qabandi/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "imapflow": "^1.7.1",
    "mailparser": "^3.9.31",
    "pg-boss": "^12.27.0",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
