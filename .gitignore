node_modules/
.pnpm-store/

# builds
dist/
.next/
out/
build/
*.tsbuildinfo

# env
.env
.env.*
!.env.example
# CI's own configuration, committed on purpose. It holds no secret: local
# addresses, a throwaway internal token, and the settings that are the same
# wherever there is a database. The connection strings and the signing key
# stay in the workflow.
!.env.ci

# test / tooling output
coverage/
playwright-report/
test-results/
.vitest/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local data
tmp/
*.log

# Database dumps and the fleet manifest — neither belongs in the repository.
# `fleet.json` names customers; `.backups/` holds their data.
.backups/
fleet.json

# Playwright session state — a real cookie, never committed.
apps/web/e2e/.auth/
apps/web/test-results/
apps/web/playwright-report/
coverage/

# MapLibre worker, copied from node_modules by apps/web/scripts/maplibre-worker.mjs
apps/web/public/maplibre/
