{
  "name": "cargosharks-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "blog:generate": "node scripts/blog/generate.mjs",
    "blog:ideate": "node scripts/blog/ideate.mjs",
    "lint": "prettier --check . && oxlint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "prettier": "^3.9.10",
    "oxlint": "^1.89.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "marked": "18.1.1",
    "motion": "^13.5.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.0.0"
  }
}
