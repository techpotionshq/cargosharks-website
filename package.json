{
  "name": "qabandi",
  "version": "0.0.0",
  "private": true,
  "description": "Qabandi Digital Freight Platform \u2014 Release One",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @qabandi/web dev",
    "dev:service": "pnpm --filter @qabandi/service dev",
    "dev:landing": "pnpm --filter @qabandi/landing dev",
    "doctor": "node scripts/doctor.mjs",
    "q": "node scripts/q.mjs",
    "build": "pnpm -r build",
    "build:landing": "pnpm --filter @qabandi/landing build",
    "preview:landing": "pnpm --filter @qabandi/landing preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint && node scripts/check-boundaries.mjs && node scripts/check-migrations.mjs && node scripts/check-messages.mjs && node scripts/check-links.mjs && node scripts/check-schedules.mjs && node scripts/check-permissions.mjs && node scripts/check-brand.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @qabandi/core test",
    "test:db": "pnpm --filter @qabandi/db test",
    "test:e2e": "pnpm --filter @qabandi/web test:e2e",
    "coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @qabandi/db generate",
    "db:generate:custom": "pnpm --filter @qabandi/db generate:custom",
    "db:provision": "pnpm --filter @qabandi/db provision",
    "db:migrate": "pnpm --filter @qabandi/db migrate",
    "db:studio": "pnpm --filter @qabandi/db studio",
    "db:seed": "pnpm --filter @qabandi/db seed",
    "db:create-user": "pnpm --filter @qabandi/db create-user",
    "db:seed-demo": "pnpm --filter @qabandi/db seed-demo",
    "db:up": "docker compose -f compose.dev.yaml up -d db",
    "db:down": "docker compose -f compose.dev.yaml down",
    "db:reset": "docker compose -f compose.dev.yaml down -v && docker compose -f compose.dev.yaml up -d db",
    "check:messages": "node scripts/check-messages.mjs",
    "tenant:new": "pnpm --filter @qabandi/db tenant-new",
    "fleet:migrate": "pnpm --filter @qabandi/db fleet-migrate",
    "fleet:status": "pnpm --filter @qabandi/db fleet-migrate --status",
    "fleet:backup": "pnpm --filter @qabandi/db fleet-backup",
    "fleet:restore-drill": "pnpm --filter @qabandi/db fleet-backup --drill",
    "db:create-branch": "pnpm --filter @qabandi/db create-branch"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
